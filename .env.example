GROQ_API_KEY=your_groq_api_key_here
GROQ_LLM_MODEL=qwen/qwen3.8-27b
GROQ_TOOL_MODEL=openai/gpt-oss-20b
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_STT_LANGUAGE=en
GROQ_STT_PROMPT=Sri Lankan English conversation. Place names may include Gampaha, Colombo, Kandy, Galle, Jaffna, and Sri Lanka.
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=troy
GROQ_TTS_MIN_INTERVAL_SECONDS=6.2
TTS_PROVIDER=kokoro
TTS_AUTO_FALLBACK=1
TTS_QUEUE_SIZE=8
TOOL_TIMEOUT_SECONDS=12
KOKORO_MODEL_PATH=backend/models/kokoro/kokoro-v1.0.int8.onnx
KOKORO_VOICES_PATH=backend/models/kokoro/voices-v1.0.bin
KOKORO_MALE_VOICE=am_michael
KOKORO_FEMALE_VOICE=af_bella
ONNX_PROVIDER=CPUExecutionProvider
KOKORO_PRELOAD=1
FRONTEND_ORIGIN=http://localhost:5173
VITE_WS_URL=ws://localhost:8000/ws
WEATHER_PREFERRED_COUNTRY=Sri Lanka
APP_TIMEZONE=Asia/Colombo
