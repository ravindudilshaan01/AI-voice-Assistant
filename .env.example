# Which LLM backend the agent loop uses: "gemini" (default) or "ollama" (fully local)
LLM_PROVIDER=gemini

# Required for LLM_PROVIDER=gemini — free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Only used if you switch LLM_PROVIDER to ollama
OLLAMA_MODEL=qwen2.5:3b

# Accuracy-oriented English transcription; use "base" if startup speed matters more
WHISPER_MODEL_SIZE=small.en
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=en
WHISPER_BEAM_SIZE=5

# edge-tts voice (free, cloud-based — not offline, just no API key needed)
EDGE_TTS_VOICE=en-US-AriaNeural
