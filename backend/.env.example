HOST=127.0.0.1
PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
GROQ_API_KEY=your_groq_api_key_here
GROQ_LLM_MODEL=llama-3.1-8b-instant
GROQ_STT_MODEL=whisper-large-v3-turbo
